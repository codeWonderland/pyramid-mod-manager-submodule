[node name="ContributorRole" type="LineEdit" parent="Details"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "\"Creator\" for a content creator; anything else (Lead Dev, Studio...) counts as the game's developers"
