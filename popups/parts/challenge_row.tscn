[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://source/mod-manager/popups/parts/challenge_row.gd" id="1_row"]

[node name="ChallengeRow" type="VBoxContainer"]
size_flags_horizontal = 3
script = ExtResource("1_row")

[node name="ChallengeText" type="LineEdit" parent="."]
unique_name_in_owner = true
layout_mode = 2
